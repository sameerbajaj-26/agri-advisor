# Copy to .env and fill in. NEVER commit .env.
# Compose overrides DATABASE_URL / REDIS_URL / OLLAMA_URL for the api container.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- Postgres (used by docker-compose and to build DATABASE_URL) ---
POSTGRES_USER=agri
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agri
# For running the API on the host (make run). Inside compose this is overridden.
DATABASE_URL=postgresql+psycopg://agri:change-me@localhost:5432/agri

# --- Cache ---
REDIS_URL=redis://localhost:6379/0
# diskcache fallback directory when Redis is unavailable
CACHE_DIR=./data/cache

# --- Live providers ---
HTTP_RETRIES=3
HTTP_TIMEOUT_S=15
SLOW_HTTP_TIMEOUT_S=30
# Included in the Nominatim User-Agent (their policy asks apps to identify themselves)
CONTACT_EMAIL=sameerbajaj9e@gmail.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- Government data ---
# Free key from https://data.gov.in (Agmarknet mandi prices resource)
DATA_GOV_API_KEY=579b464db66ec23bdd000001771944a9369d4967570e3d6593386403

# --- LLM ---
# ollama | hosted
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# a model you have pulled with `ollama pull <name>`
OLLAMA_MODEL=llama3.1
# Hosted fallback (OpenAI-compatible endpoint); only used if LLM_PROVIDER=hosted
HOSTED_LLM_BASE_URL=
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=

# --- Translation / speech (confirm exact credential names when implementing) ---
# indictrans2 | bhashini | sarvam
TRANSLATION_PROVIDER=indictrans2
BHASHINI_USER_ID=
BHASHINI_API_KEY=
SARVAM_API_KEY=
# faster-whisper model size
WHISPER_MODEL_SIZE=small

# --- RAG ---
CHROMA_DIR=./data/chroma
# sentence-transformers model name (chosen in the RAG milestone)
EMBEDDING_MODEL=

GUARD_WINDOW_HOURS=48
GUARD_RAIN_TOTAL_MM_48H=10
GUARD_RAIN_PROB_PCT=60
GUARD_HEAT_MAX_C=40
GUARD_FROST_MIN_C=2
LLM_TIMEOUT_S=180
AGENT_MAX_ITERATIONS=6
AGENT_JSON_RETRIES=2
DATA_GOV_USER_AGENT=agri-advisor/0.1 (sameerbajaj9e@gmail.com)